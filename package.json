{
  "name": "@cosmos-entity/heic-to",
  "version": "1.5.2-cosmos.1",
  "description": "Converting HEIF/HEIF image formats to PNG/JPEG in the browser",
  "main": "dist/heic-to.js",
  "exports": {
    ".": {
      "types": "./dist/heic-to.d.ts",
      "import": "./dist/heic-to.js",
      "require": "./dist/heic-to.js"
    },
    "./csp": {
      "types": "./dist/csp/heic-to.d.ts",
      "import": "./dist/csp/heic-to.js",
      "require": "./dist/csp/heic-to.js"
    },
    "./next": {
      "types": "./dist/next/heic-to.d.ts",
      "import": "./dist/next/heic-to.js",
      "require": "./dist/next/heic-to.js"
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "s": "npx http-server -o ./example",
    "test": "node --test --test-timeout=45000 tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cosmos-Entity/heic-to.git"
  },
  "types": "dist/heic-to.d.ts",
  "keywords": [
    "heic",
    "heif",
    "jpeg",
    "jpg",
    "png",
    "conversion",
    "convert",
    "image",
    "decoder"
  ],
  "author": "Hopper Gee",
  "license": "LGPL-3.0",
  "homepage": "https://github.com/hoppergee/heic-to",
  "devDependencies": {
    "esbuild": "^0.25.4",
    "http-server": "^14.1.1",
    "playwright": "1.55.1"
  },
  "files": [
    "dist",
    "src",
    "provenance",
    "LICENSE",
    "README.md",
    "docs/patched-build.md",
    "esbuild.mjs"
  ]
}
